TOTAL_CAPITAL=10000
RISK_PER_TRADE_PERCENT=0.01
TRANSACTION_FEE_PERCENT=0.0006

DISCORD_WEBHOOK_URL_VOLUME_ON=your_discord_webhook_url_for_volume_on
DISCORD_WEBHOOK_URL_VOLUME_OFF=your_discord_webhook_url_for_volume_off
DISCORD_WEBHOOK_URL_GENERAL_TARGETS=your_discord_webhook_url_for_general_targets

TARGET_FETCH_TIMES="08:00,20:00"

# --- Shotgun v3.1（docs/shotgun-v3.1-gate.md）---
# 每筆名目 = 下單權益 × NOTIONAL_PCT，最多 MAX_POSITIONS 檔；回撤要更小可改 0.05 × 20
NOTIONAL_PCT=0.10
MAX_POSITIONS=10
DISASTER_STOP_PCT=0.20
# 新倉開關：BTC 日線 > EMA200 且 寬度 ≥ BREADTH_ON；任一確定關掉就全部平倉
BREADTH_ON=0.5
BREADTH_MIN_DAILY_QV=5000000

# --- Testnet Configuration ---
# Set to "true" to enable live order execution on Binance Futures Testnet
USE_TESTNET=false
# Get testnet API keys from https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=